{
  "folders": [
    {
      "path": ".",
    },
  ],
  "settings": {
    // MkDocs markdownlint settings
    "[markdown]": {
      "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
      "editor.codeActionsOnSave": {
        "source.fixAll.markdownlint": "always",
      },
    },
    "markdownlint.config": {
      "default": false,
      "MD004": true,
      "MD007": { "indent": 4 },
      "MD009": true,
      "MD010": true,
      "MD012": { "maximum": 1 },
      "MD022": true,
      "MD030": {
        "ul_single": 1,
        "ul_multi": 1,
        "ol_single": 1,
        "ol_multi": 1,
      },
      "MD031": true,
      "MD032": true,
    },
    "yaml.schemas": {
      "https://squidfunk.github.io/mkdocs-material/schema.json": "mkdocs.yml",
    },
    "yaml.customTags": ["!!python/name scalar", "!!python/object/apply seq"],
  },
}
